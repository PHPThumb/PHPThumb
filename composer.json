{
	"name" : "phpthumb/phpthumb",
	"type" : "library",
	"license" : "MIT",
	"description" : "A fluent image manipulation library for PHP 8.2+ with interchangeable GD and Imagick backends.",
	"keywords" : [
		"image",
		"images",
		"imagick",
		"gd",
		"thumb",
		"thumbnail",
		"resize",
		"rotate",
		"crop",
		"watermark",
		"filter"
	],
	"require" : {
		"php" : ">=8.2"
	},
	"require-dev" : {
		"phpunit/phpunit" : "^9.6 || ^10.5 || ^11.0"
	},
	"suggest" : {
		"ext-gd" : "Required to use the PHPThumb\\GD backend (default for most users).",
		"ext-imagick" : "Required to use the PHPThumb\\Imagick backend. Provides support for additional formats (BMP, HEIC, TIFF) and higher-quality resampling."
	},
	"homepage" : "https://github.com/PHPThumb/PHPThumb",
	"authors" : [{
			"name" : "Ian Selby",
			"email" : "ianrselby@gmail.com"
		}, {
			"name" : "Jarrod Nettles",
			"email" : "jarrod.nettles@icloud.com"
		}
	],
	"support" : {
		"issues" : "https://github.com/PHPThumb/PHPThumb/issues",
		"discussions" : "https://github.com/PHPThumb/PHPThumb/discussions",
		"wiki" : "https://github.com/PHPThumb/PHPThumb/wiki"
	},
	"autoload" : {
		"psr-4" : {
			"PHPThumb\\" : "src/"
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"PHPThumb\\Tests\\" : "tests/PHPThumb/Tests/"
		}
	},
	"scripts" : {
		"test" : "phpunit",
		"test:gd" : "phpunit tests/PHPThumb/Tests/GDTest.php tests/PHPThumb/Tests/LoadTest.php",
		"test:imagick" : "phpunit tests/PHPThumb/Tests/ImagickTest.php tests/PHPThumb/Tests/ImagickLoadTest.php tests/PHPThumb/Tests/ImagickOperationsTest.php tests/PHPThumb/Tests/ImagickOutputTest.php tests/PHPThumb/Tests/ImagickAdvancedTest.php tests/PHPThumb/Tests/ImagickPluginTest.php tests/PHPThumb/Tests/ImagickFormatCoverageTest.php"
	},
	"scripts-descriptions" : {
		"test" : "Run the full PHPUnit test suite",
		"test:gd" : "Run only the GD backend tests",
		"test:imagick" : "Run only the Imagick backend tests"
	},
	"config" : {
		"sort-packages" : true
	}
}